# Everything the plugin ships, and nothing else: tools/release_tree.ts copies exactly these files into the tree that
# the `release` branch holds, and fails if a module the plugin loads imports something that is not listed.
# One path per line, relative to the repository root. A line with two paths copies the first to the second.
# A new runtime file belongs here; `npm run release-tree -- check` fails until it is.
.claude-plugin/plugin.json
# The tree is also a marketplace of its own, so a team can pin a released version by tag (see CONTRIBUTING.md).
release/marketplace.json .claude-plugin/marketplace.json
# And a Codex marketplace, which ChatGPT's desktop app reads before the Claude one: it lists the ChatGPT plugin, which
# tools/release_tree.ts builds into chatgpt/ (chatgpt/build.ts), as no file here can be.
release/codex-marketplace.json .agents/plugins/marketplace.json
