{
  // The core: files that run on plain data and import nothing from the engine. This config has no engine types, so a
  // core file that imports 'claude-code' fails to compile here, which is the layering rule enforced by the compiler.
  // types/index.d.ts is the plugin's contract and `claude plugin validate` makes it one self-contained file, so the
  // domain types cannot move out of it; its `declare module 'claude-code'` block needs no engine to compile.
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": []
  },
  "include": [
    "hooks/attention.ts",
    "hooks/avatar.ts",
    "hooks/decode.ts",
    "hooks/drawing.ts",
    "hooks/format.ts",
    "hooks/gitlab-status.ts",
    "hooks/gitlab.ts",
    "hooks/gitlab.generated.ts",
    "hooks/identity.ts",
    "hooks/inbox-json.ts",
    "hooks/jira.ts",
    "hooks/lease.ts",
    "hooks/markdown.ts",
    "hooks/model-text.ts",
    "hooks/mr-url.ts",
    "hooks/order.ts",
    "hooks/picture.ts",
    "hooks/problems.ts",
    "hooks/reconcile.ts",
    "hooks/status.ts",
    "hooks/svg.ts",
    "hooks/wake.ts",
    "tests/fixtures.ts",
    "tests/gitlab_fake.ts",
    "types/index.d.ts"
  ]
}
