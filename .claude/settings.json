{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --import \"$CLAUDE_PROJECT_DIR/tools/resolve_ts.ts\" \"$CLAUDE_PROJECT_DIR/tools/check_core.ts\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
